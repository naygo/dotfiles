/* Launcher grafite no estilo macOS, mesma paleta da Polybar; glass aplicado pelo Picom. */
@import "colors-current.rasi"
* {
    background-color: transparent;
    text-color: @fg;
    font: "{{FONT_UI}} {{ROFI_FONT_SIZE}}";
}
window {
    width: 520px;
    location: center;
    anchor: center;
    fullscreen: false;
    background-color: @bg;
    transparency: "real";
    border: 1px;
    border-color: @border;
    border-radius: 14px;
    padding: 14px;
}
mainbox {
    children: [ inputbar, listview ];
    spacing: 10px;
}
inputbar {
    children: [ prompt, entry ];
    spacing: 8px;
    padding: 8px 12px;
    border-radius: 8px;
    background-color: @panel;
}
prompt {
    text-color: @muted;
    vertical-align: 0.5;
}
entry {
    placeholder: "Buscar";
    placeholder-color: @muted;
    vertical-align: 0.5;
    expand: true;
}
listview {
    columns: 1;
    lines: 7;
    fixed-height: true;
    spacing: 2px;
    scrollbar: false;
    cycle: true;
}
element {
    children: [ element-icon, element-text ];
    padding: 7px 10px;
    spacing: 10px;
    border-radius: 7px;
    background-color: transparent;
    text-color: @fg;
}
element selected.normal, element selected.active {
    background-color: @selected;
    text-color: #ffffff;
}
element normal.urgent, element alternate.urgent {
    text-color: @urgent;
}
element selected.urgent {
    background-color: @urgent;
    text-color: #ffffff;
}
element-icon {
    size: 22px;
    background-color: inherit;
    text-color: inherit;
}
element-text {
    vertical-align: 0.5;
    background-color: inherit;
    text-color: inherit;
    highlight: bold;
}
