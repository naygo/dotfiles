# i3 config
# Modificador principal (Super/Win)
set $mod Mod4

# Terminal
set $term kitty

# Launcher
set $menu ~/.config/rofi/launcher.sh -show drun -show-icons

# Fonte
font pango:Ubuntu Sans 11

# ─── Inicialização ───────────────────────────────────────────────────────────

exec_always --no-startup-id xrdb -merge ~/.Xresources
exec_always --no-startup-id ~/.config/polybar/launch.sh
# Papel de parede: reaplica a última escolha de ~/dotfiles/wallpapers ($mod+Shift+w).
exec_always --no-startup-id ~/.local/bin/wallpaper --restore hilux-98.jpg
exec --no-startup-id picom --daemon
exec_always --no-startup-id python3 ~/.config/i3/sync-grouped-windows.py
exec_always --no-startup-id /usr/bin/python3 ~/.config/i3/sync-window-icons.py
# O painel de Bluetooth do Configurações só encontra o adaptador com o gsd-rfkill.
exec --no-startup-id /usr/libexec/gsd-rfkill
exec --no-startup-id dunst
exec --no-startup-id copyq

# ─── Teclas de atalho ────────────────────────────────────────────────────────

bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+Shift+q kill
bindsym $mod+Shift+r reload
bindsym $mod+Shift+e restart
bindsym $mod+t exec nautilus
bindsym $mod+Shift+x exec ~/.config/i3/logout.sh
bindsym $mod+Shift+t exec --no-startup-id ~/.local/bin/theme toggle
bindsym $mod+Shift+v exec --no-startup-id copyq toggle
bindsym $mod+Shift+w exec --no-startup-id ~/.local/bin/wallpaper

# Layout de teclado (gerenciado pelo ibus: xkb:us::eng / xkb:br::por)
bindsym Control+space exec --no-startup-id ~/.config/i3/toggle-keyboard-layout.sh

# Volume (PipeWire)
bindsym XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute        exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

# Screenshot: mesma ação do botão da barra
bindsym Print exec --no-startup-id ~/.config/polybar/scripts/capture.sh

# Brilho (helper do GNOME)
bindsym XF86MonBrightnessUp   exec --no-startup-id ~/.config/i3/brightness.sh up
bindsym XF86MonBrightnessDown exec --no-startup-id ~/.config/i3/brightness.sh down

# ─── Navegação ───────────────────────────────────────────────────────────────

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Left  focus left
bindsym $mod+Down  focus down
bindsym $mod+Up    focus up
bindsym $mod+Right focus right

# ─── Mover janelas ───────────────────────────────────────────────────────────

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

bindsym $mod+Shift+Left  move left
bindsym $mod+Shift+Down  move down
bindsym $mod+Shift+Up    move up
bindsym $mod+Shift+Right move right

# ─── Layout ──────────────────────────────────────────────────────────────────

bindsym $mod+b split h
# Esconder/mostrar as três barras e liberar/restaurar sua margem.
bindsym $mod+Shift+b exec --no-startup-id python3 ~/.config/i3/sync-bar-gaps.py --toggle
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+f floating toggle
bindsym $mod+Shift+space focus mode_toggle
floating_modifier $mod

# ─── Workspaces ──────────────────────────────────────────────────────────────

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Workspaces não são presos a monitores: cada um existe onde for aberto.
# Ao iniciar, o notebook abre o 1 e o externo (se houver) o 2, para não começarem vazios.
exec --no-startup-id ~/.config/i3/init-workspaces.sh

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# ─── Modo resize ─────────────────────────────────────────────────────────────

mode "resize" {
    bindsym h resize shrink width  10 px or 10 ppt
    bindsym j resize grow   height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize grow   width  10 px or 10 ppt

    bindsym Left  resize shrink width  10 px or 10 ppt
    bindsym Down  resize grow   height 10 px or 10 ppt
    bindsym Up    resize shrink height 10 px or 10 ppt
    bindsym Right resize grow   width  10 px or 10 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# ─── Aparência macOS — grafite e azul ──────────────────────────────────────────────────

for_window [class="^.*"] border pixel 1
# Dar respiro aos títulos nas abas e no layout empilhado.
for_window [class="^.*"] title_format "  %title  "
for_window [class="^.*"] title_window_icon padding 8px

# ─── Popovers flutuantes (Clipboard) ────────────────────────────────────────

for_window [class="copyq"] floating enable, resize set 640 480, move position center

# Painel de volume flutuante e centralizado no monitor atual.
for_window [class="(?i)^pavucontrol$"] floating enable, move position center
for_window [class="(?i)^org\.gnome\.Settings$"] floating enable, resize set 960 680, move position center

# Terminais flutuantes e centralizados no monitor atual.
for_window [class="(?i)^(kitty|xterm|gnome-terminal|org\.gnome\.Terminal)$"] floating enable, move position center

gaps inner 8
gaps outer 2
smart_gaps off

# A Polybar de cada monitor não é gerenciada pelo i3: reservar espaço no topo.
# Inner 8 + top 38 = 46 px; barras ocupam y=6 até y=44.
workspace $ws1 gaps top 38
workspace $ws2 gaps top 38
workspace $ws3 gaps top 38
workspace $ws4 gaps top 38
workspace $ws5 gaps top 38
workspace $ws6 gaps top 38
workspace $ws7 gaps top 38
workspace $ws8 gaps top 38
workspace $ws9 gaps top 38
workspace $ws10 gaps top 38

# Cores: ~/.local/bin/theme [dark|light|toggle] troca o link theme-current.conf.
include ~/.config/i3/theme-current.conf

bar {
    mode invisible
}
