# work — notebook da empresa: Ubuntu 26.04 com GNOME, i3 4.25, Polybar 3.7.2, Rofi 2.0, Picom 12.5.
#
# Todos os parâmetros da máquina. O update.sh troca cada {{NOME}} dos configs pelo valor
# daqui e copia este arquivo para ~/.config/dotfiles/machine.env, lido pelos scripts.
# Sintaxe de bash, um valor por linha (o sync-bar-gaps.py lê linha a linha).

# ─── Fontes ──────────────────────────────────────────────────────────────────
# SF Pro/SF Mono não podem ser instaladas aqui.
FONT_UI="Ubuntu Sans"
FONT_MONO="Ubuntu Sans Mono"
ROFI_FONT_SIZE=11
ICON_THEME=Yaru
# Polybar: font-1/font-2 das ações da barra e índice (1-based) da fonte dos ícones
# de volume/rede; 0 = escolha automática.
ICON_FONT="Symbols Nerd Font:size=11;3"
BRAND_FONT="Symbols Nerd Font:size=11;3"
ICON_FONT_INDEX=2

# ─── Monitores e Polybar ─────────────────────────────────────────────────────
# Notebook eDP-1 (1366×768) e externo HDMI-1, cada um com sua barra (a bandeja fica no principal).
# BAR_MONITORS: all = uma barra por monitor; primary = só no principal.
BAR_MONITORS=all
# Monitor da barra principal; vazio = o primary do xrandr.
PRIMARY_MONITOR=
# Comando xrandr rodado ao iniciar o i3; vazio = não mexe nos monitores.
XRANDR=
# Workspaces presos a monitores ("1-6:HDMI-0 7-10:DP-0"); vazio = cada um existe onde for
# aberto. Os workspaces sem barra no monitor não reservam o espaço do topo.
WS_OUTPUTS=

# ─── Rede, som e programas ───────────────────────────────────────────────────
NET_TYPE=wifi            # wifi | wired
NET_INTERFACE=wlp0s20f3  # `ip link`
NETWORK_SETTINGS="XDG_CURRENT_DESKTOP=GNOME gnome-control-center wifi &"
SOUND_SETTINGS="XDG_CURRENT_DESKTOP=GNOME gnome-control-center sound &"
FILE_MANAGER=nautilus
# Iniciados uma vez com a sessão. O gsd-rfkill é necessário para o painel de Bluetooth
# do Configurações achar o adaptador; init-workspaces abre o 1 no principal e o 2 no externo.
AUTOSTART=(/usr/libexec/gsd-rfkill ~/.config/i3/init-workspaces.sh)
# Papel de parede ao (re)iniciar o i3; $mod+Shift+w escolhe outro de wallpapers/.
WALLPAPER_CMD="~/.local/bin/wallpaper --restore hilux-98.jpg"

# ─── Teclas ──────────────────────────────────────────────────────────────────
VOLUME_UP="wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+"
VOLUME_DOWN="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
VOLUME_MUTE="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
# Helper do mutter via pkexec; o gsd-power desta versão só controla o teclado.
BRIGHTNESS_UP="~/.config/i3/brightness.sh up"
BRIGHTNESS_DOWN="~/.config/i3/brightness.sh down"
SCREENSHOT_KEY=Print

# ─── Picom ───────────────────────────────────────────────────────────────────
# Glass (90% de opacidade + blur) só em kitty, VS Code, Rofi, Dunst e Obsidian; os demais opacos.
GLASS_MATCH="class_g ?= 'kitty' || class_g ?= 'Code' || class_g ?= 'Rofi' || class_g ?= 'Dunst' || class_g ?= 'md.obsidian.Obsidian' || class_g ?= 'obsidian'"
# Exceções opacas dentro do glass; aqui nenhuma (a regra exige um match, este não casa com nada).
OPAQUE_MATCH="class_g = '__nenhuma__'"

# ─── Instalação ──────────────────────────────────────────────────────────────
# Caminhos do repo que esta máquina não recebe: o VS Code daqui tem configuração própria, e
# sem o xsettings do GNOME o settings.ini do GTK e o fontconfig mudariam os apps.
SKIP=".config/Code .config/Cursor .config/gtk-3.0 .config/gtk-4.0 .config/fontconfig .config/gnome-terminal"
# Rodado pelo ./update.sh --full.
FULL_INSTALL="install-nerd-symbols"
