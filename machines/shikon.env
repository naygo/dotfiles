# shikon — PC com Debian 13, i3 4.24, Polybar 3.7.2, Picom 12.5.
#
# Todos os parâmetros da máquina. O update.sh troca cada {{NOME}} dos configs pelo valor
# daqui e copia este arquivo para ~/.config/dotfiles/machine.env, lido pelos scripts.
# Sintaxe de bash, um valor por linha (o sync-bar-gaps.py lê linha a linha).

# ─── Fontes ──────────────────────────────────────────────────────────────────
# Instaladas pelo install-mac-fonts (--full). A Menlo dos editores é à parte: copie
# Menlo-Regular.ttf para ~/.local/share/fonts/menlo/ e rode `fc-cache -f`.
FONT_UI="SF Pro Text"
FONT_MONO="SF Mono"
ROFI_FONT_SIZE=12
ICON_THEME=Adwaita
# Polybar: font-1/font-2 das ações da barra e índice (1-based) da fonte dos ícones
# de volume/rede; 0 = escolha automática.
ICON_FONT="Font Awesome 5 Free:style=Solid:size=11;3"
BRAND_FONT="Font Awesome 5 Brands:style=Regular:size=11;3"
ICON_FONT_INDEX=0

# ─── Monitores e Polybar ─────────────────────────────────────────────────────
# Apple Cinema 20" (HDMI-0) principal à direita; Samsung 240Hz (DP-0) à esquerda; cada um com sua barra (a bandeja fica no principal).
# BAR_MONITORS: all = uma barra por monitor; primary = só no principal.
BAR_MONITORS=all
# Fixo para não depender da ordem entre o xrandr abaixo e o launch.sh da Polybar no login.
PRIMARY_MONITOR=HDMI-0
XRANDR="xrandr --output HDMI-0 --mode 1680x1050 --pos 1920x0 --rotate normal --primary --output DP-0 --mode 1920x1080 --rate 239.76 --rotate normal --pos 0x0"
WS_OUTPUTS=

# ─── Rede, som e programas ───────────────────────────────────────────────────
NET_TYPE=wired           # wifi | wired
NET_INTERFACE=enp5s0     # `ip link`
NETWORK_SETTINGS=
SOUND_SETTINGS=pavucontrol
FILE_MANAGER=thunar
# init-workspaces abre o 1 no principal e o 2 no outro.
AUTOSTART=(nm-applet blueman-applet ~/.config/i3/init-workspaces.sh)
# Foto local (fora do repo) centralizada sobre o fundo do tema; $mod+Shift+w escolhe um de wallpapers/ até o próximo reinício do i3.
WALLPAPER_CMD="~/.local/bin/wallpaper --restore ~/Pictures/Wallpapers/momo.png"

# ─── Teclas ──────────────────────────────────────────────────────────────────
VOLUME_UP="pactl set-sink-volume @DEFAULT_SINK@ +5%"
VOLUME_DOWN="pactl set-sink-volume @DEFAULT_SINK@ -5%"
VOLUME_MUTE="pactl set-sink-mute @DEFAULT_SINK@ toggle"
BRIGHTNESS_UP="brightnessctl set +5%"
BRIGHTNESS_DOWN="brightnessctl set 5%-"
SCREENSHOT_KEY=Control+Shift+4

# ─── Instalação ──────────────────────────────────────────────────────────────
# Caminhos do repo que esta máquina não recebe.
SKIP=
# Rodado pelo ./update.sh --full: fontes da Apple e perfil do GNOME Terminal (SF Mono 10).
FULL_INSTALL="install-mac-fonts && dconf load /org/gnome/terminal/ < ~/.config/gnome-terminal/settings.dconf"
