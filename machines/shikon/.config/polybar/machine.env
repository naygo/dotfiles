# Lido por polybar/launch.sh e i3/sync-bar-gaps.py.
# all: uma barra por monitor (a do principal tem a bandeja); primary: só no principal.
BAR_MONITORS=primary
# Monitor da barra principal; vazio = o primary do xrandr. Fixar evita a corrida
# com o xrandr do login (o launch.sh pode rodar antes do monitors.sh).
PRIMARY_MONITOR=HDMI-0
