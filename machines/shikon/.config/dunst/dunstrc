# Graphite Dark — transparência e blur aplicados pelo Picom.
[global]
    monitor = 0
    follow = none
    origin = top-right
    offset = (10, 46)
    width = 380
    height = (0, 300)
    notification_limit = 5

    font = SF Pro Text 10
    markup = full
    format = "<span foreground='#b5b7c0' size='small'>%a</span>\n<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    line_height = 3
    padding = 14
    horizontal_padding = 16
    text_icon_padding = 12
    ellipsize = end
    ignore_newline = no

    icon_position = left
    min_icon_size = 32
    max_icon_size = 40
    icon_corner_radius = 6
    corner_radius = 16
    frame_width = 1
    frame_color = "#484a50"
    gap_size = 8
    separator_height = 0
    transparency = 0

    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 340
    progress_bar_corner_radius = 3

    sort = yes
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    sticky_history = yes
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#202124"
    foreground = "#b5b7c0"
    frame_color = "#303136"
    highlight = "#64b5ff"
    timeout = 10

[urgency_normal]
    background = "#202124"
    foreground = "#f5f5f7"
    frame_color = "#484a50"
    highlight = "#0a84ff"
    timeout = 10

[urgency_critical]
    background = "#202124"
    foreground = "#f5f5f7"
    frame_color = "#ff6961"
    highlight = "#ff6961"
    timeout = 0
