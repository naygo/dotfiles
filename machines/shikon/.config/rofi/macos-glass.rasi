/* Spotlight-inspired launcher; blur provided by Picom. */
@import "colors-current.rasi"
* {
    background-color: transparent;
    text-color: @fg;
    font: "SF Pro Text 12";
}
window {
    width: 620px;
    location: center;
    anchor: center;
    fullscreen: false;
    background-color: @bg;
    transparency: "real";
    border: 0px;
    border-radius: 16px;
    padding: 20px;
}
mainbox {
    children: [ inputbar, listview ];
    spacing: 12px;
}
inputbar {
    children: [ entry ];
    padding: 6px 10px 12px;
    border: 0px 0px 1px;
    border-color: @panel;
}
entry {
    placeholder: "Buscar…";
    placeholder-color: @muted;
    expand: true;
}
listview {
    columns: 1;
    lines: 6;
    fixed-height: true;
    spacing: 2px;
    scrollbar: false;
    cycle: true;
}
element {
    children: [ element-icon, element-text ];
    padding: 8px 10px;
    spacing: 10px;
    border: 0px;
    border-radius: 6px;
    background-color: transparent;
    text-color: @fg;
}
element selected.normal, element selected.active {
    background-color: @sel-bg;
    text-color: @sel-fg;
}
element normal.urgent, element alternate.urgent {
    text-color: @urgent;
}
element selected.urgent {
    background-color: @panel;
    text-color: @urgent;
}
element-icon {
    size: 20px;
    background-color: inherit;
    text-color: inherit;
}
element-text {
    vertical-align: 0.5;
    background-color: inherit;
    text-color: inherit;
    highlight: bold;
}
